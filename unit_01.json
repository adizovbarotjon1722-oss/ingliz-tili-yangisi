   "explanation_uz": "<b>Verb be — I / you</b>\n\n✅ <b>Darak gap:</b> I'm (=I am) Anvar. · You're (=You are) Lola.\n❌ <b>Inkor:</b> I'm not on holiday. · You aren't here to study.\n❓ <b>Savol:</b> Are you here on holiday? → Yes, I am. / No, I'm not.\n\n💡 Savolda <b>Are</b> gapning boshiga chiqadi: <i>You are</i> → <i>Are you</i>...?\n💡 Qisqa javobda fe'lni qisqartirmaymiz: <i>Yes, I am.</i> (❌ Yes, I'm.)",
   "vocab": [
    {
     "en": "Hello / Hi",
     "uz": "Salom",
     "example": "Hello, I'm Anvar."
    },
    {
     "en": "Nice to meet you",
     "uz": "Tanishganimdan xursandman",
     "example": "Nice to meet you, too."
    },
    {
     "en": "on business",
     "uz": "ish safarida",
     "example": "I'm here on business."
    },
    {
     "en": "on holiday",
     "uz": "ta'tilda / dam olishda",
     "example": "We're here on holiday."
    },
    {
     "en": "to study",
     "uz": "o'qish uchun",
     "example": "I'm here to study."
    },
    {
     "en": "here",
     "uz": "bu yerda",
     "example": "Are you here on holiday?"
    },
    {
     "en": "yes / no",
     "uz": "ha / yo'q",
     "example": "Yes, I am. No, I'm not."
    },
    {
     "en": "and you?",
     "uz": "Sizchi?",
     "example": "I'm fine. And you?"
    }
