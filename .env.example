# ==========================================================
#  English A1 Course Bot - muhit sozlamalari
#  Bu faylni ".env" nomi bilan nusxalab to'ldiring
# ==========================================================

# --- Bot ---
BOT_TOKEN=8937873616:AAFOTldUXJ-wFKz0F7K-g1RO804_B0N2C3U
# Bot nomi / kurs nomi (o'quvchilarga ko'rinadi)
COURSE_TITLE=English A1 - Boshlang'ich kurs

# --- Bosh administratorlar (Telegram ID, vergul bilan) ---
# O'zingizning ID ingizni @userinfobot orqali bilib oling
SUPERADMIN_IDS=602455217

# --- Ma'lumotlar bazasi ---
# Lokal / kichik guruh (o'rnatish shart emas):
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# Katta yuklama (minglab o'quvchi) uchun PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://bot:parol@127.0.0.1:5432/english_bot

# --- Redis (ixtiyoriy, minglab o'quvchi uchun tavsiya etiladi) ---
# Bo'sh qoldirsangiz xotiradagi saqlash ishlatiladi
REDIS_URL=

# --- Sun'iy intelekt (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OpenAI-mos boshqa server ishlatsangiz (masalan OpenRouter):
OPENAI_BASE_URL=
AI_ENABLED=true

# --- Server / Webhook (production uchun) ---
# Bo'sh qoldirsangiz "polling" rejimida ishlaydi (lokal uchun qulay)
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change-me-to-random-string
PORT=8080

# --- Xavfsizlik ---
# Bir o'quvchi 1 sekundda yubora oladigan maksimal so'rov
THROTTLE_RATE=2.0
THROTTLE_BURST=12

# --- Vaqt zonasi (O'zbekiston: UTC+5) ---
TZ_OFFSET=5

# --- Log ---
LOG_LEVEL=INFO
